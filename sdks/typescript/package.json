{
  "name": "@sandforge/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Sandforge hypervisor sandbox platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "node --test 'dist/**/*.test.js'",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive:true, force:true})\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "sandforge",
    "sandbox",
    "virtualization",
    "hypervisor"
  ],
  "author": "Sandforge Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yanurag-dev/sandforge.git"
  },
  "homepage": "https://github.com/yanurag-dev/sandforge",
  "bugs": {
    "url": "https://github.com/yanurag-dev/sandforge/issues"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
